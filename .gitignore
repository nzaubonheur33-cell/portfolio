# ===========================================
# .gitignore — Bonheur Nzau Portfolio
# ===========================================

# --- Dépendances ---
node_modules/
package-lock.json

# --- Variables d'environnement (NE JAMAIS committer) ---
.env
.env.local
.env.*.local

# --- Build output ---
dist/
client/dist/
server/dist/
build/

# --- Prisma / Base de données ---
*.db
*.sqlite
*.sqlite3

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Éditeurs & IDE ---
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Dossiers IA (Antigravity, Claude, Cursor, Devin) ---
.agents/
.claude/
.cursor/
.devin/
.vite/

# --- Fichiers temporaires ---
*.tmp
*.bak