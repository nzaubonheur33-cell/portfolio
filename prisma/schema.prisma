generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PROJECTS
// ============================================================
model Project {
  id              Int                 @id @default(autoincrement())
  title           String
  slug            String              @unique
  description     String              @db.Text
  longDescription String?             @db.Text
  image           String?
  githubUrl       String?
  liveUrl         String?
  featured        Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  technologies    ProjectTechnology[]
}

model ProjectTechnology {
  id        Int     @id @default(autoincrement())
  projectId Int
  name      String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================================
// CONTACT
// ============================================================
model ContactMessage {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  subject     String
  projectType String
  message     String   @db.Text
  status      String   @default("UNREAD") // UNREAD, READ, REPLIED, ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// ADMIN
// ============================================================
model AdminUser {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// SKILLS (Gestion dynamique des compétences)
// ============================================================
model Skill {
  id        Int      @id @default(autoincrement())
  category  String   // ex: "Frontend", "Backend", "Database", "DevOps"
  name      String
  level     Int      @default(80) // 0 - 100 (pourcentage de maîtrise)
  icon      String?  // Nom de l'icône Material Symbols ou emoji
  order     Int      @default(0) // Ordre d'affichage
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// EXPERIENCE (Parcours professionnel dynamique)
// ============================================================
model Experience {
  id          Int      @id @default(autoincrement())
  title       String   // ex: "Développeur Full-Stack"
  company     String   // ex: "Freelance"
  location    String?  // ex: "Kinshasa, RDC"
  startDate   DateTime
  endDate     DateTime? // null = poste actuel
  current     Boolean  @default(false)
  description String   @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// EDUCATION (Formation académique dynamique)
// ============================================================
model Education {
  id          Int      @id @default(autoincrement())
  degree      String   // ex: "Bachelor en Informatique"
  school      String   // ex: "Université de Kinshasa"
  location    String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean  @default(false)
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// ARTICLES (Blog technique)
// ============================================================
model Article {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String   @db.Text  // Résumé court
  content     String   @db.LongText // Contenu Markdown complet
  coverImage  String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  readTime    Int      @default(5) // Minutes de lecture estimées
  tags        String?  // JSON array string ex: '["React","Node.js"]'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
