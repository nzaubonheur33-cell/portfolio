# =============================================================
# VARIABLES D'ENVIRONNEMENT — Copiez ce fichier en .env
# cp .env.example .env
# =============================================================

# --- Base de données MySQL ---
DATABASE_URL="mysql://root:VOTRE_MOT_DE_PASSE@localhost:3306/portfolio_db"

# --- Authentification JWT ---
# Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="votre_secret_jwt_32_caracteres_minimum"

# --- Emails via Resend (optionnel) ---
# Créez un compte gratuit sur https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# --- URLs ---
CLIENT_URL="http://localhost:5173"
PORT=5000
